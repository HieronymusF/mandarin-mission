  "fixed_sql": [
    {
      "name": "installed_content_packages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"installed_content_packages\" (\"package_id\" TEXT NOT NULL, \"version\" TEXT NOT NULL, \"schema_version\" INTEGER NOT NULL, \"manifest_hash\" TEXT NOT NULL, \"installed_at\" TEXT NOT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_active\" IN (0, 1)), PRIMARY KEY (\"package_id\", \"version\"));"
        }
      ]
    },
    {
      "name": "lesson_progress_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lesson_progress_entries\" (\"lesson_id\" TEXT NOT NULL, \"status\" TEXT NOT NULL CHECK(\"status\" IN ('not_started', 'in_progress', 'completed')), \"score\" INTEGER NULL CHECK(\"score\" IS NULL OR \"score\" BETWEEN 0 AND 100), \"started_at\" TEXT NULL, \"completed_at\" TEXT NULL, \"content_version\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"lesson_id\"));"
        }
      ]
    },
    {
      "name": "mastery_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"mastery_states\" (\"item_id\" TEXT NOT NULL, \"dimension\" TEXT NOT NULL CHECK(\"dimension\" IN ('meaning', 'listening', 'tone', 'hanzi')), \"box\" INTEGER NOT NULL CHECK(\"box\" BETWEEN 0 AND 5), \"confidence\" REAL NOT NULL CHECK(\"confidence\" BETWEEN 0.0 AND 1.0), \"due_at\" TEXT NOT NULL, \"last_result\" TEXT NULL, \"last_reviewed_at\" TEXT NULL, \"same_day_retry_count\" INTEGER NOT NULL DEFAULT 0 CHECK(\"same_day_retry_count\" BETWEEN 0 AND 2), \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"item_id\", \"dimension\"));"
        }
      ]
    },
    {
      "name": "review_attempts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_attempts\" (\"attempt_id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL, \"dimension\" TEXT NOT NULL CHECK(\"dimension\" IN ('meaning', 'listening', 'tone', 'hanzi')), \"result\" TEXT NOT NULL CHECK(\"result\" IN ('forgotten', 'vague', 'remembered')), \"correct\" INTEGER NOT NULL CHECK (\"correct\" IN (0, 1)), \"used_hint\" INTEGER NOT NULL CHECK (\"used_hint\" IN (0, 1)), \"latency_ms\" INTEGER NOT NULL CHECK(\"latency_ms\" >= 0), \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"attempt_id\"));"
        }
      ]
    },
    {
      "name": "speaking_attempts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"speaking_attempts\" (\"attempt_id\" TEXT NOT NULL, \"target_id\" TEXT NOT NULL, \"local_score\" REAL NULL CHECK(\"local_score\" IS NULL OR \"local_score\" BETWEEN 0.0 AND 1.0), \"provider_score\" REAL NULL CHECK(\"provider_score\" IS NULL OR \"provider_score\" BETWEEN 0.0 AND 1.0), \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"attempt_id\"));"
        }
      ]
    },
    {
      "name": "sync_outbox_events",
      "sql": [
